// IMPLEMENTATION SPECIMEN: not compiled or registered as a passing test.
// Copy into CounterStrikeSharp.Tests.Native after implementing the bridge.
// CsScriptRuntime, its generated API, and CsScriptBridgeFixture are proposed.
// Fixture responsibilities are specified in counterstrikesharp-cs-script-handover.md.
using System;
using System.Linq;
using System.Threading.Tasks;
using CounterStrikeSharp.API;
using CounterStrikeSharp.API.Core;
using CounterStrikeSharp.API.Modules.CsScript;
using CounterStrikeSharp.API.Modules.Utils;
using Xunit;

namespace NativeTestsPlugin;

public sealed class CsScriptBridgeTests : IClassFixture<CsScriptBridgeFixture>
{
    private readonly CsScriptBridgeFixture fixture;

    public CsScriptBridgeTests(CsScriptBridgeFixture fixture)
    {
        this.fixture = fixture;
    }

    [Fact]
    public Task ReadOnlyMethod_UsesTheCurrentGameRules()
    {
        // RunAsync dispatches to the game thread after this host becomes ready.
        return fixture.RunAsync(runtime =>
        {
            Assert.Equal(
                fixture.CurrentGameRules.WarmupPeriod,
                runtime.GameRules.IsWarmupPeriod());
        });
    }

    [Fact]
    public Task EntityMethod_WrapsAnEntityInTheHostContext()
    {
        return fixture.RunAsync(runtime =>
        {
            var entity = Utilities.CreateEntityByName<CBaseEntity>("info_target");
            Assert.NotNull(entity);
            Assert.True(entity.IsValid);

            try
            {
                entity.DispatchSpawn();
                var name = "css_bridge_probe_" + Guid.NewGuid().ToString("N");
                runtime.Entity(entity).SetEntityName(name);

                // Read through the native CSS schema, independently of V8.
                Assert.Equal(name, entity.Entity!.Name);
            }
            finally
            {
                if (entity.IsValid)
                    entity.Remove();
            }
        });
    }

    [Theory]
    [InlineData(true)]
    [InlineData(false)]
    public Task AddTeamMoney_UsesValveCallbackAndHonorsOptionalAmount(bool explicitAmount)
    {
        // Sets up a controlled round and restores test-owned state afterward.
        // No parallel awards, purchases, restarts, or other economy tests.
        return fixture.RunControlledEconomyAsync((runtime, scenario) =>
        {
            Assert.False(runtime.GameRules.IsWarmupPeriod());
            Assert.NotEmpty(scenario.EligibleCtPlayers);
            Assert.True(scenario.ConfiguredReward > 0);

            var before = scenario.EligibleCtPlayers.ToDictionary(
                player => player.EntityHandle.Raw,
                player => player.InGameMoneyServices!.Account);
            var controlBefore = scenario.OpposingPlayer.InGameMoneyServices!.Account;
            var expectedDelta = explicitAmount ? 100 : scenario.ConfiguredReward;

            // This test-only observer hooks the resolved V8 callback (14192:
            // 0xB82890), not merely the native award routine. Do not invoke it.
            using var callback = fixture.ObserveMoneyCallback();

            if (explicitAmount)
            {
                // Exercises the optional CCSGameRules convenience facade too.
                fixture.CurrentGameRules.Script(runtime).AddTeamMoney(
                    (double)CsTeam.CounterTerrorist, scenario.RewardReason, 100d);
            }
            else
            {
                // Must send argc=2, not a fabricated third argument of zero.
                runtime.GameRules.AddTeamMoney(
                    (double)CsTeam.CounterTerrorist, scenario.RewardReason);
            }

            Assert.Equal(1, callback.EntryCount);
            foreach (var player in scenario.EligibleCtPlayers)
            {
                Assert.Equal(
                    before[player.EntityHandle.Raw] + expectedDelta,
                    player.InGameMoneyServices!.Account);
            }
            Assert.Equal(controlBefore, scenario.OpposingPlayer.InGameMoneyServices!.Account);

            // A follow-up invocation also checks that ordinary call teardown worked.
            Assert.Equal(
                fixture.CurrentGameRules.WarmupPeriod,
                runtime.GameRules.IsWarmupPeriod());
        });
    }
}
